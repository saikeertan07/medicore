# ==============================================================================
# MediCore AI - Unified Environment Configuration Template
# ==============================================================================

# Database Configuration
# DATABASE_ENGINE must be explicitly 'postgresql' in production or 'sqlite' for local dev
DATABASE_ENGINE=postgresql
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_secure_password_change_me
POSTGRES_DB=medicore_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medicore:medicore_secure_password_change_me@localhost:5432/medicore_db

# Security & Authentication
ENVIRONMENT=production
# SECRET_KEY is mandatory in production (at least 32 cryptographically random characters).
# Example generator: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Networking & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
